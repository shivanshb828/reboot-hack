########################################################################
# To expand flags or positional arguments for a specific subcommand    #
# you can include a line such as:                                      #
#                                                                      #
# subcommand --flag1 --flag2=value argument                            #
#                                                                      #
# You can also include one flag or argument per line:                  #
#                                                                      #
# subcommand --flag1                                                   #
# subcommand --flag2=value                                             #
# subcommand argument                                                  #
#                                                                      #
# To only expand flags or arguments if a specific config is used with  #
# a subcommand include lines that include 'subcommand:config', for     #
# example:                                                             #
#                                                                      #
# subcommand:use-foo --flag3=foo                                       #
#                                                                      #
# Then you can expand that config on the command line via:             #
#                                                                      #
# rbt subcommand --config=use-foo`                                     #
########################################################################

# Find '.proto' files in 'api'.
generate api

# Specify output folder for generated code for Python backend.
generate --python=backend/api

# Specify output folder for generated code for React frontend.
generate --react=web/src/api

# Watch if any generated or source files are modified.
dev run --watch=backend/api/**/*.py
dev run --watch=backend/src/**/*.py
dev run --generate-watch

# Tell `rbt` that this is a Python application.
dev run --python

# Run the application!
dev run --application=backend/src/main.py

# Save state between restarts.
dev run --application-name=triagedesk

# Default to HMR mode for MCP UI development.
dev run --default-config=hmr

# HMR: Vite dev server proxied through Envoy.
# Run Vite separately with: cd frontend && npm run dev
dev run --frontend-root-path=frontend
dev run:hmr --frontend-host=http://localhost:4444

# Dist mode: serve pre-built MCP UI artifacts from frontend/dist.
# Build first with: cd frontend && npm run build
dev run:dist --frontend-dist-path=frontend/dist

# Production serving mirrors dist mode.
serve run --python
serve run --frontend-dist-path=frontend/dist --frontend-root-path=frontend
serve run --application=backend/src/main.py
serve run --application-name=triagedesk

# When expunging, expunge that state we've saved.
dev expunge --application-name=triagedesk
